# phrase_entry (P1-06): a phrase typed with the keys, the hex pad on the white keys, EDIT, PRESETS
# and the knobs, then played (ADR-029). The demo holds steps 0 4 8 C E: we type on the others.
wait 100
# NOTE: a key writes the note and, on an empty step, the instrument; the cursor goes down one step
turn SELECT 1
key C4
expect cell 1 0 48
expect cell 1 2 0
expect cursor row 2
# SEL+OCT+: edit step 2
press SEL
tap OCT+
release SEL
expect step 2
expect octave 3
key E4
expect cell 2 0 52
expect cursor row 4
press SEL
tap OCT-
release SEL
expect step 1
# with SEL held, the keys write nothing
press SEL
key G4
release SEL
expect cell 4 0 51
expect cursor row 4
shot entry_notes.png
# EDIT on a note: OFF; again: the note comes back; SEL+EDIT clears; EDIT brings the last note
turn SELECT -2
tap EDIT
expect cell 2 0 0xFE
tap EDIT
expect cell 2 0 52
press SEL
tap EDIT
release SEL
expect cell 2 0 0xFF
tap EDIT
expect cell 2 0 52
# PRESETS: +-1 semitone; with SEL, +-1 octave
turn PRESETS 2
expect cell 2 0 54
press SEL
turn PRESETS -1
release SEL
expect cell 2 0 42
# VOL: the 16 white keys are hex digits, and light dim
turn ALGO 1
expect cursor col 1
expect dim_keys 0x5AD5AD5
key w7
expect pending 7
shot entry_pending.png
key w15
expect pending -1
expect cell 2 1 0x7F
# a lone digit is taken after 1.5 s
turn SELECT 1
key w3
wait 1000
expect pending 3
wait 600
expect pending -1
expect cell 3 1 3
# ... or at the next move
key w9
turn SELECT -1
expect pending -1
expect cell 3 1 9
turn SELECT 1
# INSTR: above 1F stays 1F; the keys then play that instrument
turn ALGO 1
key w2
key w5
expect cell 3 2 0x1F
expect instr 0x1F
key w0
key w0
expect cell 3 2 0
expect instr 0
# FX: white keys 1..6 pick a family, again the next command of it; they light dim
turn ALGO 1
expect cursor col 3
expect dim_keys 0x2D5
key w0
expect cell 3 3 1
key w0
expect cell 3 3 2
key w3
expect cell 3 3 20
turn PRESETS 1
expect cell 3 3 21
press SEL
turn PRESETS 1
release SEL
expect cell 3 3 26
# its value
turn ALGO 1
key w4
key w0
expect cell 3 4 0x40
# SEL+EDIT on the command clears it and its value; EDIT puts the last one back
turn ALGO -1
press SEL
tap EDIT
release SEL
expect cell 3 3 0
expect cell 3 4 0
tap EDIT
expect cell 3 3 26
# EDIT on a value picks it up: EDIT on an empty cell of that column copies it
turn ALGO -2
turn SELECT -1
expect cell 2 1 0x7F
tap EDIT
turn SELECT 4
expect cell 6 1 0xFF
tap EDIT
expect cell 6 1 0x7F
# the knobs: CUT and RES of the instrument, SEL for +-16
turn K1 3
expect iparam 5 0x93
press SEL
turn K2 -1
release SEL
expect iparam 6 0x70
shot entry_done.png
# PLAY: what was typed plays
wav entry.wav
tap PLAY
wait 2100
tap PLAY
wait 300
wavstop
