# SPDX-License-Identifier: GPL-3.0-only
# hello (P0-04): a monophonic sine on the keyboard, octave by OCT- / OCT+, note and name on screen
wait 100
expect peak 0
expect pixel 0 0 0x10A2
shot hello_idle.png
# one note, recorded from silence: attack, sustain, release
wav hello.wav
wait 20
key C4 down
wait 300
expect keys 0x80
expect lit_keys 0x80
expect peak >4000
shot hello.png
key C4 up
wait 150
wavstop
expect lit_keys 0
peakreset
wait 50
expect peak 0
# monophonic, last note wins; letting go of it goes back to the one still held
wav hello_mono.wav
key C4 down
wait 150
key E4 down
wait 150
expect lit_keys 0x880
key E4 up
wait 150
key C4 up
wait 150
wavstop
# octave: the lit OCT button says which way the keyboard moved
tap OCT+
expect lit_buttons 0x2
key C4 down
wait 50
shot hello_oct.png
key C4 up
tap OCT-
expect lit_buttons 0
tap OCT-
expect lit_buttons 0x1
tap OCT+
# the octave stops at 7 and at 0: from 3, five up then four down is 3 again (nothing lit)
tap OCT+
tap OCT+
tap OCT+
tap OCT+
tap OCT+
tap OCT-
tap OCT-
tap OCT-
expect lit_buttons 0x2
tap OCT-
expect lit_buttons 0
tap OCT-
tap OCT-
tap OCT-
tap OCT-
tap OCT+
tap OCT+
expect lit_buttons 0x1
tap OCT+
expect lit_buttons 0
# MASTER at 0: silent, even with a note held
master 0
key C4 down
wait 100
peakreset
wait 100
expect peak 0
key C4 up
master 2048
wait 200
# held buttons light
press SEL
wait 20
expect lit_buttons 0x8
leds
release SEL
# the app does not read the encoders: the detents wait for it
turn K1 3
turn K1 -1 10
expect enc K1 2
